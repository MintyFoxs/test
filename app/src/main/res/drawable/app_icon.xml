<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C2030"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#F39DBD"/>
            <stroke android:color="#FFFFFF" android:width="2dp"/>
        </shape>
    </item>
    <item android:left="17dp" android:right="17dp" android:top="19dp" android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#B7D09D"/>
            <stroke android:color="#374E39" android:width="2dp"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</layer-list>
